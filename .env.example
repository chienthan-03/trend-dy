# Database
DATABASE_URL=postgresql://factory:factory@localhost:5432/factory

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth (NestJS httpOnly session cookie; Next.js rewrites /api/v1/* → API)
SESSION_SECRET=change-me-to-a-long-random-string
STUDIO_EMAIL=studio@example.com
STUDIO_PASSWORD=change-me-studio-password

# API (NestJS). Next.js (port 3000) rewrites /api/v1/* → API_ORIGIN/api/v1/*
# so the session cookie is same-origin for the browser.
PORT=3001
API_ORIGIN=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MinIO / S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET=factory
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

# AI Gateway (Vercel AI SDK)
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODE=fake
AI_DAILY_BUDGET_USD=10

# Douyin ranking adapter: fake | live
DOUYIN_ADAPTER=fake
