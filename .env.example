# Database
DATABASE_URL=postgresql://factory:factory@localhost:5432/factory

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth (NestJS httpOnly session cookie; Next.js rewrites /api/v1/* → API)
SESSION_SECRET=change-me-to-a-long-random-string
STUDIO_EMAIL=studio@example.com
STUDIO_PASSWORD=change-me-studio-password

# API (NestJS). Next.js (port 3000) rewrites /api/v1/* → API_ORIGIN/api/v1/*
# so the session cookie is same-origin for the browser.
PORT=3001
API_ORIGIN=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MinIO / S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET=factory
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

# AI Gateway (Vercel AI SDK)
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODE=fake
AI_DAILY_BUDGET_USD=10

# Douyin ranking adapter: fake | live
DOUYIN_ADAPTER=fake
DOUYIN_API_PROVIDER=justoneapi
DOUYIN_API_TOKEN=
DOUYIN_API_BASE_URL=https://api.justoneapi.com
# DOUYIN_API_PROVIDER=http
# DOUYIN_HTTP_FETCH_URL=
# DOUYIN_HTTP_BEARER=
# DOUYIN_LIVE_ADAPTER_MODULE=

# Phase A — Remix
REMIX_ENABLED=true
REMIX_DEFAULT_LOCALE=vi
REMIX_LLM_MODEL=openai/gpt-4o-mini
REMIX_STUDIO_BRAND=STUDIO ALPHA

# Phase B — Full script (STT)
REMIX_SCRIPT_MODE=caption
REMIX_ALLOW_MEDIA_DOWNLOAD=false
REMIX_MEDIA_TTL_DAYS=7
REMIX_STT_MODE=fake
# OpenRouter (with AI_GATEWAY_URL): openai/whisper-large-v3-turbo (~$0.04/hr)
# OpenAI direct: whisper-1 ($0.006/min)
REMIX_STT_MODEL=openai/whisper-large-v3-turbo
# Optional override for Analytics cost estimates (defaults inferred from model)
# REMIX_STT_COST_PER_MINUTE_USD=0.000667
# Optional: dedicated STT endpoint (defaults to AI_GATEWAY_URL or api.openai.com)
# REMIX_STT_API_URL=https://api.openai.com/v1
# verbose_json (OpenAI direct) | json (OpenRouter / gateways)
# REMIX_STT_RESPONSE_FORMAT=json
REMIX_MAX_MEDIA_MB=50
REMIX_MEDIA_DOWNLOAD_TIMEOUT_MS=600000
REMIX_STT_MAX_UPLOAD_MB=24
REMIX_STT_AUDIO_BITRATE_KBPS=24
FFMPEG_PATH=ffmpeg

# Phase B — Transcript translation (LLM recommended for accuracy)
REMIX_TRANSLATE_ENABLED=true
REMIX_TRANSLATE_MODE=fake
REMIX_TRANSLATE_PROVIDER=llm
# REMIX_TRANSLATE_LLM_MODEL=openai/gpt-4o
# REMIX_TRANSLATE_LLM_BATCH_SIZE=30
# Skip remix_generate when only translated transcript is needed
# REMIX_SKIP_GENERATE=true

# Remix TTS (fake = silence; live = OpenAI-compatible /audio/speech via OpenRouter or OpenAI)
REMIX_TTS_MODE=fake
REMIX_TTS_API_URL=
REMIX_TTS_API_KEY=
# OpenRouter (uses OPENAI_API_KEY when REMIX_TTS_API_KEY empty):
#   REMIX_TTS_MODEL=x-ai/grok-voice-tts-1.0
#   REMIX_TTS_VOICE=eve
# OpenAI direct: tts-1 / alloy
REMIX_TTS_MODEL=tts-1
REMIX_TTS_VOICE=alloy
REMIX_TTS_MAX_SPEED=1.25
REMIX_TTS_COST_PER_1K_CHARS_USD=0.015

# Remix render (fake = minimal MP4 fixture; live = FFmpeg audio replace + letterbox)
REMIX_RENDER_MODE=fake
REMIX_LETTERBOX_RATIO=0.10
# Required on Windows Gyan ffmpeg (no fontconfig). Example: C:/Windows/Fonts/arial.ttf
REMIX_RENDER_FONT_PATH=C:/Windows/Fonts/arial.ttf
REMIX_DUB_MAX_UPLOAD_MB=30
# Original-track gain under TTS narration windows (0=mute narrator, 1=no duck). Default 0.
REMIX_DUCK_GAIN=0
# FFMPEG_PATH=ffmpeg — see Phase B — Full script above

# Legacy: Google Translate
# REMIX_TRANSLATE_PROVIDER=google
# REMIX_TRANSLATE_SOURCE_LANG=auto
# GOOGLE_TRANSLATE_API_KEY=
# REMIX_TRANSLATE_BATCH_DELAY_MS=250

# Legacy: HuggingFace (not recommended)
# REMIX_TRANSLATE_PROVIDER=huggingface
# REMIX_TRANSLATE_MODEL=Helsinki-NLP/opus-mt-zh-vi
# HF_API_TOKEN=
# REMIX_TRANSLATE_API_URL=https://router.huggingface.co/hf-inference
# REMIX_TRANSLATE_MAX_RETRIES=5
