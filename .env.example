# Database
DATABASE_URL=postgresql://factory:factory@localhost:5432/factory

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth
SESSION_SECRET=change-me-to-a-long-random-string

# MinIO / S3-compatible storage
S3_ENDPOINT=http://localhost:9000
